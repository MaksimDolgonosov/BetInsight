# The Odds API
ODDS_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
# One model for the value track
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Three models for the ai_pick vote. OpenRouter ids, three different providers, json_schema support
OPENROUTER_AI_PICK_MODEL_1=
OPENROUTER_AI_PICK_MODEL_2=
OPENROUTER_AI_PICK_MODEL_3=
# Web search model, does not vote, returns a plain text news summary. Empty means MODEL_1 with the OpenRouter web plugin
OPENROUTER_AI_PICK_RESEARCH_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
# Chat id or @username. The bot is an admin of both channels. TELEGRAM_CHANNEL_URL stays the public link on the site.
TELEGRAM_CHANNEL_RU=
TELEGRAM_CHANNEL_EN=

# Neon PostgreSQL
# Pooled connection for the Next.js app
DATABASE_URL=
# Direct connection for Drizzle migrations
DATABASE_URL_UNPOOLED=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron
CRON_SECRET=

# Auth.js
AUTH_SECRET=
AUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
